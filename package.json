{
  "name": "kodra",
  "displayName": "KODRA",
  "description": "An AI coding assistant that understands your entire codebase. Supports local models via Ollama and cloud providers like OpenAI and Anthropic.",
  "version": "0.1.3",
  "publisher": "SandipGiri",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.webp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SandipGiri-Developer/KODRA.git"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding assistant",
    "ollama",
    "openai",
    "anthropic",
    "codebase",
    "indexing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:KODRA.chatView",
    "onCommand:KODRA.openChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "KODRA.openChat",
        "category": "Kodra",
        "title": "Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "KODRA.newChat",
        "category": "Kodra",
        "title": "New Chat Session",
        "icon": "$(add)"
      },
      {
        "command": "KODRA.viewHistory",
        "category": "Kodra",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "KODRA.openSettings",
        "category": "Kodra",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "KODRA.indexWorkspace",
        "category": "Kodra",
        "title": "Index Workspace"
      },
      {
        "command": "KODRA.reindexWorkspace",
        "category": "Kodra",
        "title": "Re-index Workspace (Full)"
      },
      {
        "command": "KODRA.cancelIndexing",
        "category": "Kodra",
        "title": "Cancel Indexing"
      },
      {
        "command": "KODRA.addFileContext",
        "category": "Kodra",
        "title": "Add File to Chat Context"
      },
      {
        "command": "KODRA.addSelectionContext",
        "category": "Kodra",
        "title": "Add Selection to Chat Context"
      },
      {
        "command": "KODRA.configureProvider",
        "category": "Kodra",
        "title": "Configure AI Provider"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "KODRA-sidebar",
          "title": "KODRA",
          "icon": "media/icon.webp"
        }
      ]
    },
    "views": {
      "KODRA-sidebar": [
        {
          "id": "KODRA.chatView",
          "name": "KODRA Assistant",
          "type": "webview",
          "icon": "$(symbol-function)"
        }
      ]
    },
    "submenus": [
      {
        "id": "KODRA.kodraSubMenu",
        "label": "Kodra"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "KODRA.kodraSubMenu",
          "group": "0_akodra"
        }
      ],
      "KODRA.kodraSubMenu": [
        {
          "command": "KODRA.addSelectionContext",
          "when": "editorHasSelection",
          "group": "Kodra"
        },
        {
          "command": "KODRA.addFileContext",
          "group": "Kodra"
        }
      ],
      "explorer/context": [
        {
          "command": "KODRA.addFileContext",
          "group": "Kodra"
        }
      ],
      "view/title": [
        {
          "command": "KODRA.newChat",
          "when": "view == KODRA.chatView",
          "group": "navigation@1"
        },
        {
          "command": "KODRA.viewHistory",
          "when": "view == KODRA.chatView",
          "group": "navigation@2"
        },
        {
          "command": "KODRA.openSettings",
          "when": "view == KODRA.chatView",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "KODRA.openChat",
        "mac": "cmd+k",
        "key": "ctrl+k"
      },
      {
        "command": "KODRA.openChat",
        "mac": "cmd+l",
        "key": "ctrl+l"
      },
      {
        "command": "KODRA.addSelectionContext",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "KODRA",
      "properties": {
        "KODRA.providers": {
          "type": "array",
          "default": [],
          "description": "Configured AI providers and their settings."
        },
        "KODRA.workspaceModels": {
          "type": "array",
          "default": [],
          "description": "Selected AI models for the workspace."
        },
        "KODRA.provider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "openai",
            "anthropic",
            "gemini"
          ],
          "enumDescriptions": [
            "Local Ollama instance (free, private)",
            "OpenAI API (requires API key)",
            "Anthropic Claude API (requires API key)",
            "Google Gemini API (requires API key)"
          ],
          "description": "Legacy fallback provider setting."
        },
        "KODRA.modelName": {
          "type": "string",
          "default": "",
          "description": "The model name to use. Leave empty for provider default (e.g., llama3.2 for Ollama, gpt-4o-mini for OpenAI, claude-3-5-sonnet-20241022 for Anthropic)."
        },
        "KODRA.ollama.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama API endpoint URL."
        },
        "KODRA.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL."
        },
        "KODRA.gemini.endpoint": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta",
          "description": "Google Gemini API endpoint URL."
        },
        "KODRA.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens for model responses."
        },
        "KODRA.indexing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic workspace indexing for context-aware responses."
        },
        "KODRA.indexing.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size in bytes to index (default: 1MB)."
        },
        "KODRA.indexing.additionalIgnorePatterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional glob patterns to exclude from indexing (gitignore syntax)."
        },
        "KODRA.embedding.provider": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "ollama",
            "openai"
          ],
          "enumDescriptions": [
            "Local in-process embeddings via Transformers.js (zero setup, private, fast)",
            "Ollama embeddings (free, local, requires running Ollama)",
            "OpenAI-compatible embeddings API"
          ],
          "description": "Embedding provider for codebase semantic search."
        },
        "KODRA.embedding.model": {
          "type": "string",
          "default": "all-MiniLM-L6-v2",
          "description": "Embedding model name. Default: all-MiniLM-L6-v2 for local, nomic-embed-text for Ollama."
        },
        "KODRA.embedding.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama API endpoint (when embedding provider is ollama)."
        },
        "KODRA.agent.maxIterations": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of agent tool-use iterations per request."
        },
        "KODRA.agent.requireApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require explicit user approval before applying file modifications."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run package && node -e \"const fs=require('fs');const p=require('path');['encoder.json','vocab.bpe'].forEach(f=>{fs.copyFileSync(p.join('node_modules','gpt-3-encoder',f),p.join('dist',f));console.log('Copied',f);})\"",
    "compile": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map && node -e \"const fs=require('fs');const p=require('path');['encoder.json','vocab.bpe'].forEach(f=>{fs.copyFileSync(p.join('node_modules','gpt-3-encoder',f),p.join('dist',f));console.log('Copied',f);})\"",
    "build:webview": "cd webview && npm run build",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "package:vsix": "npx @vscode/vsce package --no-dependencies --allow-package-all-secrets"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "gpt-tokenizer": "^2.2.1",
    "ignore": "^5.3.1",
    "sharp": "^0.35.5",
    "uuid": "^9.0.0",
    "vectra": "^0.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.138.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.0"
  }
}
